# Copy to .env and fill in. Never commit or share .env (it is in .gitignore).
# Token from the LinkedIn OAuth flow with the scopes openid profile w_member_social (docs/linkedin-setup.md).
LINKEDIN_ACCESS_TOKEN=
# The day the token expires, as YYYY-MM-DD (about 60 days after you got it): the script warns 7 days before.
LINKEDIN_TOKEN_EXPIRES=
# Optional: urn:li:person:XXXX (python3 scripts/publish.py --check prints it). Empty: read at each run.
LINKEDIN_PERSON_URN=
